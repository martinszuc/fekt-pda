<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry including="**/*.java" kind="src" output="target/classes" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-10">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="lib" path="lib/bcel-6.2.jar"/>
	<classpathentry kind="lib" path="lib/codesize-1.2.jar"/>
	<classpathentry kind="lib" path="lib/picocontainer-2.14.2.jar"/>
	<classpathentry kind="lib" path="lib/robocode.battle-1.9.3.7.jar"/>
	<classpathentry kind="lib" path="lib/robocode.core-1.9.3.7.jar"/>
	<classpathentry kind="lib" path="lib/robocode.host-1.9.3.7.jar"/>
	<classpathentry kind="lib" path="lib/robocode.jar"/>
	<classpathentry kind="lib" path="lib/robocode.repository-1.9.3.7.jar"/>
	<classpathentry kind="lib" path="lib/robocode.sound-1.9.3.7.jar"/>
	<classpathentry kind="lib" path="lib/robocode.ui-1.9.3.7.jar"/>
	<classpathentry kind="lib" path="lib/robocode.ui.editor-1.9.3.7.jar"/>
	<classpathentry kind="lib" path="lib/roborumble.jar"/>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" path="target/generated-sources/annotations">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
			<attribute name="ignore_optional_problems" value="true"/>
			<attribute name="m2e-apt" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" output="target/test-classes" path="target/generated-test-sources/test-annotations">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
			<attribute name="ignore_optional_problems" value="true"/>
			<attribute name="m2e-apt" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
